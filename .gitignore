server/uploads/*
!server/uploads/.gitkeep

# SQLite database files
*.db
*.db-journal
*.db-shm
*.db-wal

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/
