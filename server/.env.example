# Copy this file to .env and fill in the values. Never commit .env.

# Server
PORT=3000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection (used by Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/archmakers

# Signing login sessions — use a long random string
JWT_SECRET=change-me

# Email sending (Resend)
RESEND_API_KEY=
EMAIL_FROM=ArchMakers <hello@archmakers.com>

# Uploaded 3D files
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
