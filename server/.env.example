# Copy this file to .env and change the values if needed. Never commit .env.
# Without a .env file the server uses these same defaults.

# Server
PORT=3001
NODE_ENV=development

# SQLite database file (relative to the server/ folder; created automatically)
DATABASE_PATH=data/archmakers.db

# Later (not used yet):
